# Trello project-board synchronization (optional)
# TRELLO_API_KEY also seeds the in-app Task Board's Trello link (Settings →
# Connections); TRELLO_TOKEN and TRELLO_BOARD_NAME are used only by the
# `pnpm trello:sync` repo-maintenance board script, not the app feature —
# see docs/dev/fixes/TRELLO.md.
TRELLO_API_KEY=replace_with_your_trello_api_key
TRELLO_TOKEN=replace_with_your_trello_token
TRELLO_BOARD_NAME="Gerer Build Studio Tasks"
